# GitHub (optional - improves rate limits)
GITHUB_TOKEN=

# Contact form (required for the form to deliver anything)
# Default provider. Free, no domain of your own needed, no card.
# Form ID is the last path segment from your Formspree form URL.
FORMSPREE_FORM_ID=

# Upgrade path, only if you later own a domain and verify it in Resend.
# The default onboarding@resend.dev sender can only deliver to the Resend
# account owner, so this needs CONTACT_FROM_EMAIL on a verified domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=zhameersheraztampugao@gmail.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000